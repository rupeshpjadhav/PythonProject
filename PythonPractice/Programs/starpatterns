n=10
for i in range (n):
    print ("*" * i)
    
for i in range (n,0,-1):
    print ("*" * i)
    
for i in range (1,n):
    print ((" " * (n-i)) + ("*" * i) )
    
for i in range (1,n):   # pyramid
    print ((" " * (n-i)) + ("*" * (2*i-1)) )
    
for i in range (n,0,-1):  # inverted pyramid
    print ((" " * (n-i)) + ("*" * (2*i-1)) )  
    
    
for i in range (1,n):
    print (("&" * i) + (2 *(" " * (n-i))) + ("&" * i))
    
for i in range (n,0,-1):
    print(("&" * i) + (2 * (" " * (n-i))) + ("&" * i))

